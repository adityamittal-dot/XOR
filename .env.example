# Django
DEBUG=True
SECRET_KEY=change-me-generate-with-get_random_secret_key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
LOG_LEVEL=INFO

# Database
# Leave DB_NAME empty to fall back to SQLite for local development.
# Inside Docker Compose, DB_HOST must be "db" (the service name).
DB_NAME=xor_db
DB_USER=xor_user
DB_PASSWORD=xor_password
DB_HOST=db
DB_PORT=5432

# Frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
THROTTLE_LAB_AI=20/hour

# Uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Media storage (optional)
# Leave R2_BUCKET_NAME empty to store uploaded files on local disk.
# Set all four to move uploads to an S3-compatible bucket (e.g. Cloudflare
# R2), needed on hosts with an ephemeral or no persistent filesystem.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
