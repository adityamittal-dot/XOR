# Django
DEBUG=True
SECRET_KEY=change-me-generate-with-get_random_secret_key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
LOG_LEVEL=INFO

# Database
# Leave DB_NAME empty to fall back to SQLite for local development.
# Inside Docker Compose, DB_HOST must be "db" (the service name).
DB_NAME=xor_db
DB_USER=xor_user
DB_PASSWORD=xor_password
DB_HOST=db
DB_PORT=5432

# Frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
THROTTLE_LAB_AI=20/hour

# Uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Media storage (optional)
# Leave S3_BUCKET_NAME empty to store uploaded files on local disk.
# Set these to move uploads to an S3-compatible bucket instead, needed on
# hosts with an ephemeral or no persistent filesystem. Works with Backblaze
# B2 (free, no card required - see README), Cloudflare R2, AWS S3, or MinIO.
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
# Leave empty for Cloudflare R2 ("auto"); set to your bucket's real region
# for Backblaze B2 or AWS S3, e.g. "us-west-004".
S3_REGION_NAME=
